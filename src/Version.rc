#include <winres.h>
#include "Version.hpp"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WA_VERSION_MAJOR, WA_VERSION_MINOR, WA_VERSION_PATCH, 0
 PRODUCTVERSION WA_VERSION_MAJOR, WA_VERSION_MINOR, WA_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Wooting Analog for Cyberpunk 2077 (RED4ext plugin)"
            VALUE "FileVersion", WA_VERSION_STRING
            VALUE "InternalName", "WootingAnalog"
            VALUE "OriginalFilename", "WootingAnalog.dll"
            VALUE "ProductName", "Wooting Analog for Cyberpunk 2077"
            VALUE "ProductVersion", WA_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
